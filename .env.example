# Copy to .env and adjust. All inter-layer ports live here.
# Keep CORS_ORIGIN host+port aligned with VITE_DEV_PORT.
# Keep VITE_KEYCLOAK_URL aligned with KEYCLOAK_URL / KEYCLOAK_HTTP_PORT.
# Keep VITE_API_PROXY_TARGET aligned with PORT.
# If you change VITE_DEV_PORT, also update redirect URIs in
# infrastructure/sso/deltacore-realm.json and re-import the realm.

# --- Frontend (Vite) ---
VITE_DEV_PORT=5173
VITE_API_PROXY_TARGET=http://127.0.0.1:4000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=DeltaCoreRealm
VITE_KEYCLOAK_CLIENT_ID=deltacore-frontend-client
VITE_DB2_ODBC_DSN=AZ7DB
# Comma-separated table names for the lab Run comparison button
VITE_SCHEMA_COMPARE_TABLES=ACCCR7

# --- Backend (Express) ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=DeltaCoreRealm
# Optional override; default is ${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}
# KEYCLOAK_ISSUER=http://localhost:8080/realms/DeltaCoreRealm

# --- Keycloak (Docker) ---
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Db2 AZ7 lab (Docker + unixODBC) ---
DB2_HOSTNAME=127.0.0.1
DB2_HOST_PORT=50000
DB2_CONTAINER_PORT=50000
DB2_NAME=AZ7DB
DB2_USER=db2inst1
DB2_PASSWORD=db2admin
DB2_ODBC_DSN=AZ7DB
# JSON array used when biz_data_sources has no row for the DSN
DB2_SEARCH_PATH=["AZBASWQA","AZLOSWQACL","AXSWQACL"]

# --- unixODBC (location of the Driver Manager, not the DSN files) ---
# DSN files stay in infrastructure/odbc via ODBCINI / ODBCSYSINI (set in env.sh).
# UNIXODBC_LIB_DIR = folder that contains libodbc.dylib or libodbc.so
#   macOS Homebrew ARM:  $(brew --prefix unixodbc)/lib
#   macOS Homebrew Intel: /usr/local/opt/unixodbc/lib
#   Linux:                /usr/lib64  or  /usr/local/lib
#   IBM i PASE:           typically under /QOpenSys/pkgs/lib
# UNIXODBC_LIB_DIR=
# Optional copy of odbc.ini into the Driver Manager etc dir (isql without env.sh)
# UNIXODBC_SYSCONF=/opt/homebrew/etc
# IBM CLI home (default: repo infrastructure/odbc/clidriver)
# IBM_DB_HOME=
# Shared library name inside $IBM_DB_HOME/lib (libdb2.dylib | libdb2.so)
# IBM_DB_LIB=
